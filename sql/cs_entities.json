				"options": {
					"unsigned": true,
					"notnull": true
				}
			},
			{
				"name": "cse_assoc_page_id",
				"comment": "page_id of the page this comment stream belongs to",
				"type": "integer",
				"options": {
					"unsigned": true,
					"notnull": true
				}
			},
			{
				"name": "cse_parent_id",
