					"unsigned": true,
					"notnull": true
				}
			},
			{
				"name": "cse_last_editor_actor",
				"comment": "actor.actor_id of the last editor, null if never edited",
				"type": "bigint",
				"options": {
					"unsigned": true,
					"notnull": false
				}
